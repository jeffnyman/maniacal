<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- the packages carry XML documentation. The missing-comment warning is off here, and back on
         for Maniacal.Scumm, whose public API is documented in full. (The SDK derives the
         documentation file name before Directory.Build.targets is read, so this lives here.) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Maniacal</Product>
    <Authors>Jeff Nyman</Authors>
    <Copyright>Copyright (c) Jeff Nyman. Portions derived from ScummVM, copyright the ScummVM Team, and from Daventry, copyright Jeff Nyman.</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/jeffnyman/maniacal</RepositoryUrl>
    <PackageProjectUrl>https://github.com/jeffnyman/maniacal</PackageProjectUrl>
    <!-- dotnet pack -p:VersionSuffix=alpha.2 for the next prerelease; an empty suffix is a release -->
    <VersionPrefix>1.0.1</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <!-- nuget.org renders a package's README as Markdown alone, without the HTML the GitHub one
         uses: the packages carry NUGET.md, the same in Markdown, with links that work there -->
    <PackageReadmeFile>NUGET.md</PackageReadmeFile>
    <!-- the player's own icon, its 128-pixel image, for the packages' listing on nuget.org -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>scumm;maniac-mansion;lucasfilm;c64;adventure;interpreter;scummvm;retro;games</PackageTags>
    <PackageReleaseNotes>The page on nuget.org, fixed: nuget.org renders a package's README as Markdown alone, and 1.0.0's, the one on GitHub, lost its title, badges, screenshots and author there with the HTML it uses. The packages now carry the same README in Markdown, with links that work on nuget.org, and the player's icon, the mansion. Nothing else has changed: the player and the library are 1.0.0's, and so is the public API.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)NUGET.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)assets/icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
