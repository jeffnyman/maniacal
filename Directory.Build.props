<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- the packages carry XML documentation. The missing-comment warning is off here, and back on
         for Maniacal.Scumm, whose public API is documented in full. (The SDK derives the
         documentation file name before Directory.Build.targets is read, so this lives here.) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Maniacal</Product>
    <Authors>Jeff Nyman</Authors>
    <Copyright>Copyright (c) Jeff Nyman. Portions derived from ScummVM, copyright the ScummVM Team, and from Daventry, copyright Jeff Nyman.</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/jeffnyman/maniacal</RepositoryUrl>
    <PackageProjectUrl>https://github.com/jeffnyman/maniacal</PackageProjectUrl>
    <!-- dotnet pack -p:VersionSuffix=alpha.2 for the next prerelease; an empty suffix is a release -->
    <VersionPrefix>0.5.0</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>scumm;maniac-mansion;lucasfilm;c64;adventure;interpreter;scummvm;retro;games</PackageTags>
    <PackageReleaseNotes>Sixth prerelease; code written against 0.4.x builds and runs as it was. New: GameInspector.Verbs and VerbName(verb), the names a release shows its verbs by, for the numbers objects' verb tables use (the NES has its own, and no Fix, Unlock or What is); numbers that are no verb a player picks (16, 253, 255) have none. Fixed: in the 1987 DOS release and its demo, a figure facing left was drawn seven pixels too far left (the meteor, and Syd and Razor facing Dave); it is placed as ScummVM places it. Packing now compares the library with the last release on nuget.org, so a public member removed or changed fails the build.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
