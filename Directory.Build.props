<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- the packages carry XML documentation. The missing-comment warning is off here, and back on
         for Maniacal.Scumm, whose public API is documented in full. (The SDK derives the
         documentation file name before Directory.Build.targets is read, so this lives here.) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Maniacal</Product>
    <Authors>Jeff Nyman</Authors>
    <Copyright>Copyright (c) Jeff Nyman. Portions derived from ScummVM, copyright the ScummVM Team, and from Daventry, copyright Jeff Nyman.</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/jeffnyman/maniacal</RepositoryUrl>
    <PackageProjectUrl>https://github.com/jeffnyman/maniacal</PackageProjectUrl>
    <!-- dotnet pack -p:VersionSuffix=alpha.2 for the next prerelease; an empty suffix is a release -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>scumm;maniac-mansion;lucasfilm;c64;adventure;interpreter;scummvm;retro;games</PackageTags>
    <PackageReleaseNotes>The first release: the public API is promised, and follows semantic versioning, so a 1.x adds to it and changes none of it. Plays every English release ScummVM knows, from the title screen to the end: the Commodore 64 release and its demo, the 1987 DOS release and its demo, the 1988 DOS release, the American NES cartridge, the Atari ST and the Amiga; saves made in each load in ScummVM. Code written against 0.5.0-alpha builds and runs as it was; nothing has changed since it but the version.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
