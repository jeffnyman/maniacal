<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- the packages carry XML documentation. The missing-comment warning is off here, and back on
         for Maniacal.Scumm, whose public API is documented in full. (The SDK derives the
         documentation file name before Directory.Build.targets is read, so this lives here.) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Maniacal</Product>
    <Authors>Jeff Nyman</Authors>
    <Copyright>Copyright (c) Jeff Nyman. Portions derived from ScummVM, copyright the ScummVM Team, and from Daventry, copyright Jeff Nyman.</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/jeffnyman/maniacal</RepositoryUrl>
    <PackageProjectUrl>https://github.com/jeffnyman/maniacal</PackageProjectUrl>
    <!-- dotnet pack -p:VersionSuffix=alpha.2 for the next prerelease; an empty suffix is a release -->
    <VersionPrefix>0.4.0</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>scumm;maniac-mansion;lucasfilm;c64;adventure;interpreter;scummvm;retro;games</PackageTags>
    <PackageReleaseNotes>Fourth prerelease. Breaking: DetectedGame and SaveInfo are records with init properties, no longer positional (make them with { ... }); the host contract drops what no engine read: IHost.DeterministicTime, IInputDriver.GetMouseState, HeadlessInput.Mouse and GetMouseState, and MouseState. New: the NES release (the American cartridge, a .nes dump or its .prg), with its title screens, sound and own save screen; the Atari ST release, from its .st disk image; the Amiga release, from its two .adf disk images, with its own sound in stereo; the C64 demo; Palettes.Nes and Palettes.Amiga. Every release is won by the walkthrough tests, and its saves load in ScummVM 2026.4.0 and the other way round. Fixed: a save made with another release is refused, by name, before the world is touched; save errors are InvalidDataException; the MD5 lookup is built once whatever the thread. The maniacal tool plays every release, keeping their saves in maniac/nes, maniac/atari and maniac/amiga.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
