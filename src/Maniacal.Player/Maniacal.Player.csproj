<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>maniacal</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageId>Maniacal</PackageId>
    <ToolCommandName>maniacal</ToolCommandName>
    <!-- a tool installed under a newer runtime should still start -->
    <RollForward>Major</RollForward>
    <Description>Command line player for Maniac Mansion (Commodore 64, DOS 1987 and 1988): dotnet tool install -g Maniacal, then maniacal &lt;game folder&gt;.</Description>
  </PropertyGroup>

  <!-- SDL3 ships native libraries for every platform; a desktop tool does not need the Android
       and iOS ones, which are most of the package -->
  <Target Name="ManiacalTrimMobileNatives" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '^runtimes[\\/](android|ios)'))" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\Maniacal.Scumm\Maniacal.Scumm.csproj" />
    <PackageReference Include="ppy.SDL3-CS" />
  </ItemGroup>
</Project>
