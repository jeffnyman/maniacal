<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>The SCUMM interpreter for Maniac Mansion (V0, V1 and V2), ported from ScummVM.</Description>
    <!-- optimized in Debug too: unoptimized, the per-pixel drawing makes the tests take seven times as long -->
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Maniacal.Scumm.Tests" />
    <!-- for now: the player's headless run and its inspection tools (room, costume, script, view) still
         reach into the engine; which of that becomes public API is decided before a 1.0 -->
    <InternalsVisibleTo Include="maniacal" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
