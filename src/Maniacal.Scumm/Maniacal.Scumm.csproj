<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>The SCUMM interpreter for Maniac Mansion (V0, V1 and V2), ported from ScummVM.</Description>
    <!-- optimized in Debug too: unoptimized, the per-pixel drawing makes the tests take seven times as long -->
    <Optimize>true</Optimize>
    <!-- every public member is documented: a missing comment fails the build -->
    <NoWarn>$(NoWarn.Replace('CS1591', ''))</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Maniacal.Scumm.Tests" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
